# Dépendances (Le dossier le plus lourd, jamais dans Git)
node_modules/
jspm_packages/

# Logs (Utile pour le debug, mais polluant pour le dépôt)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs
*.log

# Variables d'environnement (SÉCURITÉ : contient vos clés API, mots de passe)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build et Sortie (Fichiers générés par TypeScript ou Webpack)
dist/
build/
out/
.next/

# Dossiers d'IDE (Configuration spécifique à votre éditeur)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj

# Couverture de tests
coverage/
.nyc_output/

# Divers
.DS_Store
Thumbs.db

# Cache de compilation TypeScript
*.tsbuildinfo